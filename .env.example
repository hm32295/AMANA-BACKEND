# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replica Set recommended for multi-document ACID transactions)
# Example: mongodb://127.0.0.1:27017/amana?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/amana?replicaSet=rs0

# Set to true only for local/automated testing without an external MongoDB instance
USE_IN_MEMORY_MONGO=false

# Allowed CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Security Secrets (MUST be strong random 32+ char strings in production)
JWT_SECRET=
JWT_EXPIRES_IN=12h
OTP_HMAC_SECRET=
FIELD_ENCRYPTION_KEY=

# Optional CLI/Seed Admin Configuration (never hardcode production passwords)
ADMIN_SEED_NAME=مدير النظام
ADMIN_SEED_EMAIL=
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=

# SMS Provider: twilio | generic_http | mock
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=AMANA

# Controlled file uploads directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
